---
import Reveal from "./react/Reveal.tsx";
import ProcessTimeline from "./react/ProcessTimeline.tsx";
---

<section class="relative overflow-hidden border-y border-line bg-sand py-24 md:py-28" id="process">
  <div aria-hidden class="dot-grid pointer-events-none absolute inset-0 opacity-60"></div>
  <div aria-hidden class="pointer-events-none absolute left-1/2 top-0 h-[300px] w-[600px] -translate-x-1/2 rounded-full bg-amber-glow/10 blur-[110px]"></div>
  <div class="relative mx-auto w-[min(1260px,92%)]">
    <Reveal client:visible variant="blur">
      <div class="mx-auto max-w-[680px] text-center">
        <span class="mb-3 inline-flex items-center gap-2 text-[0.76rem] font-bold uppercase tracking-[0.22em] text-toffee"><span class="h-px w-8 bg-amber-glow"></span>From orchid to bean<span class="h-px w-8 bg-amber-glow"></span></span>
        <h2 class="font-serif-display text-[clamp(2.2rem,3.8vw,3.2rem)] font-medium">Why <span class="italic text-toffee">curing</span> matters</h2>
        <p class="mt-3 text-muted">A green pod has almost no fragrance. The signature scent develops through time, patience, and craftsmanship — follow the journey down the line.</p>
      </div>
    </Reveal>
    <ProcessTimeline client:visible />
  </div>
</section>
