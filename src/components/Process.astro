---
import Reveal from "./react/Reveal.tsx";
const steps = [
  { n: "01", t: "Pollination", d: "Each vanilla flower opens for only one day and is pollinated by hand with care." },
  { n: "02", t: "Maturation", d: "Pods grow on the vine for several months until full maturity before harvesting." },
  { n: "03", t: "Curing", d: "Scalding, sweating, and slow sun-drying help vanillin develop naturally." },
  { n: "04", t: "Selection", d: "Beans are sorted for aroma, length, and moisture before reaching your kitchen." },
];
---

<section class="border-y border-line bg-sand py-24 md:py-28" id="process">
  <div class="mx-auto w-[min(1260px,92%)]">
    <Reveal client:visible variant="blur">
      <div class="mx-auto max-w-[680px] text-center">
        <span class="mb-3 inline-block text-[0.76rem] font-bold uppercase tracking-[0.22em] text-toffee">From orchid to bean</span>
        <h2 class="font-serif-display text-[clamp(2.2rem,3.8vw,3.2rem)] font-medium">Why curing matters</h2>
        <p class="mt-3 text-muted">A green pod has almost no fragrance. The signature scent develops through time, patience, and craftsmanship.</p>
      </div>
    </Reveal>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <Reveal client:visible variant="flip" delay={i * 0.12}>
          <div class="group flex h-full flex-col rounded-2xl border border-line bg-white p-8 transition-all duration-500 hover:-translate-y-3 hover:rotate-[-0.5deg] hover:border-amber-glow hover:shadow-[0_20px_45px_rgba(30,19,11,0.15)]">
            <div class="font-serif-display mb-3 bg-gradient-to-br from-amber-glow to-amber-deep bg-clip-text text-6xl font-bold leading-none text-transparent transition group-hover:scale-105">{s.n}</div>
            <h4 class="font-serif-display mb-3 text-2xl font-semibold">{s.t}</h4>
            <p class="text-[0.9rem] leading-relaxed text-muted">{s.d}</p>
            <div class="mt-auto flex gap-1.5 pt-6">
              <div class="h-1 flex-1 rounded bg-line transition-all duration-500 group-hover:bg-amber-glow"></div>
              <div class="h-1 flex-1 rounded bg-line transition-all duration-500 delay-75 group-hover:bg-amber-glow"></div>
              <div class="h-1 flex-1 rounded bg-line transition-all duration-500 delay-150 group-hover:bg-amber-glow"></div>
            </div>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
