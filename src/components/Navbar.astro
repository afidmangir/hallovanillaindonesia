---
import WaIcon from "./WaIcon.astro";
const WA = "https://wa.me/62881026050105?text=Hello%20hallovanilla.indonesia%2C%20I%20am%20interested%20in%20your%20vanilla%20beans.";
const IG = "https://instagram.com/hallovanilla.indonesia";
const EMAIL = "mailto:hallovanillaindonesia@gmail.com";
---

<header id="navbar" class="sticky top-0 z-[100] border-b border-line bg-cream/90 backdrop-blur-xl transition-all">
  <div class="mx-auto flex h-[72px] w-[min(1260px,92%)] items-center justify-between gap-4">
    <!-- KIRI: logo + teks saja -->
    <a href="#home" class="flex items-center gap-2.5" aria-label="hallovanilla home">
      <img src="/logo-brown.png" alt="hallovanilla logo" class="h-10 w-10 rounded-full border border-amber-glow/40 bg-white object-cover shadow-sm" />
      <span class="font-serif-display text-[1.5rem] font-semibold lowercase tracking-tight text-cocoa">hallovanilla</span>
    </a>

    <!-- TENGAH: nav desktop -->
    <nav class="hidden items-center gap-8 lg:flex">
      <a href="#home" class="text-[0.9rem] font-medium text-muted transition hover:text-amber-deep">Home</a>
      <a href="#products" class="text-[0.9rem] font-medium text-muted transition hover:text-amber-deep">Products</a>
      <a href="#process" class="text-[0.9rem] font-medium text-muted transition hover:text-amber-deep">Process</a>
      <a href="#gallery" class="text-[0.9rem] font-medium text-muted transition hover:text-amber-deep">Gallery</a>
      <a href="#contact" class="text-[0.9rem] font-medium text-muted transition hover:text-amber-deep">Contact</a>
    </nav>

    <!-- KANAN: ikon sosmed -->
    <div class="flex items-center gap-2">
      <a href={EMAIL} aria-label="Email hallovanilla" title="hallovanillaindonesia@gmail.com" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-cocoa transition hover:-translate-y-0.5 hover:border-amber-glow hover:text-amber-deep">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
      </a>
      <a href={IG} target="_blank" rel="noopener" aria-label="Instagram hallovanilla.indonesia" title="@hallovanilla.indonesia" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-cocoa transition hover:-translate-y-0.5 hover:border-amber-glow hover:text-amber-deep">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a href={WA} target="_blank" rel="noopener" aria-label="WhatsApp hallovanilla" title="+62 881-0260-50105" class="grid h-10 w-10 place-items-center rounded-full bg-[#25D366] text-white shadow-md transition hover:-translate-y-0.5 hover:bg-[#20BA5A]">
        <WaIcon size={19} />
      </a>
      <button id="menuBtn" aria-label="Open Menu" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-lg lg:hidden">☰</button>
    </div>
  </div>
  <div id="mobileMenu" class="hidden border-t border-line bg-cream px-6 py-4 lg:hidden">
    <div class="flex flex-col gap-3 text-[0.95rem] font-medium">
      <a href="#home">Home</a>
      <a href="#products">Products</a>
      <a href="#process">Process</a>
      <a href="#gallery">Gallery</a>
      <a href="#contact">Contact</a>
      <div class="mt-2 flex gap-2">
        <a href={EMAIL} aria-label="Email" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-cocoa">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        </a>
        <a href={IG} target="_blank" rel="noopener" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-cocoa">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href={WA} target="_blank" rel="noopener" aria-label="WhatsApp" class="grid h-10 w-10 place-items-center rounded-full bg-[#25D366] text-white"><WaIcon size={19} /></a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('mobileMenu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu?.classList.add('hidden')));
  const header = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) header?.classList.add('shadow-[0_10px_30px_rgba(35,23,14,0.08)]');
    else header?.classList.remove('shadow-[0_10px_30px_rgba(35,23,14,0.08)]');
  });
</script>
