---
import WaIcon from "./WaIcon.astro";
const WA = "https://wa.me/62881026050105?text=Hello%20hallovanilla.indonesia%2C%20I%20am%20interested%20in%20your%20vanilla%20beans.";
const IG = "https://instagram.com/hallovanilla.indonesia";
const EMAIL = "mailto:hallovanillaindonesia@gmail.com";
const LINKS = [
  { href: "#home", label: "Home" },
  { href: "#products", label: "Products" },
  { href: "#process", label: "Process" },
  { href: "#gallery", label: "Gallery" },
  { href: "#contact", label: "Contact" },
];
---

<header id="siteHeader">
  <!-- Blur gradient di belakang header: konten yang naik mendekati header larut ke dalam blur yang semakin tebal -->
  <div class="header-blur" aria-hidden="true"></div>

  <!-- Pill melayang: transparan di atas, kaca blur saat scroll. Tanpa border. -->
  <div class="nav-pill">
    <div class="nav-shell flex items-center justify-between gap-4">
      <!-- KIRI: logo + teks -->
      <a href="#home" class="flex min-w-0 items-center gap-3" aria-label="hallovanilla home">
        <img src="/logo-white.png" alt="hallovanilla logo" class="logo-pop -ml-3.5 h-[74px] w-[74px] shrink-0 rounded-full bg-white object-cover sm:-ml-7 sm:h-[86px] sm:w-[86px]" />
        <span class="font-serif-display truncate text-[1.3rem] font-semibold lowercase tracking-tight text-cocoa sm:text-[1.65rem]">hallovanilla.indonesia</span>
      </a>

      <!-- TENGAH: nav desktop -->
      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {LINKS.map((l) => (
          <a href={l.href} data-spy class="nav-link">{l.label}</a>
        ))}
      </nav>

      <!-- KANAN: sosmed (tablet/desktop) + toggle (mobile) -->
      <div class="flex shrink-0 items-center gap-2">
        <div class="hidden items-center gap-2 md:flex">
          <a href={EMAIL} aria-label="Email hallovanilla" title="hallovanillaindonesia@gmail.com" class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </a>
          <a href={IG} target="_blank" rel="noopener" aria-label="Instagram hallovanilla.indonesia" title="@hallovanilla.indonesia" class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href={WA} target="_blank" rel="noopener" aria-label="WhatsApp hallovanilla" title="+62 881-0260-50105" class="grid h-10 w-10 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_8px_20px_rgba(37,211,102,0.35)] transition hover:-translate-y-0.5 hover:bg-[#20BA5A]">
            <WaIcon size={18} />
          </a>
        </div>
        <button id="menuBtn" aria-label="Toggle menu" aria-expanded="false" class="nav-burger lg:hidden">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu: kartu kaca di bawah pill -->
  <div id="mobileMenu" class="lg:hidden" aria-hidden="true">
    <div class="menu-clip overflow-hidden">
      <div class="menu-card">
        <nav class="flex flex-col gap-1" aria-label="Mobile">
          {LINKS.map((l, i) => (
            <a href={l.href} data-spy style={`--i:${i}`} class="m-link">
              <span>{l.label}</span><span class="m-arrow">→</span>
            </a>
          ))}
        </nav>
        <a href={WA} target="_blank" rel="noopener" style="--i:5" class="m-cta">
          <WaIcon size={18} /><span>Chat WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  #siteHeader {
    --hp: 0;
    position: fixed;
    top: max(10px, env(safe-area-inset-top));
    left: 0;
    right: 0;
    z-index: 100;
    pointer-events: none; /* hanya pill & menu yang bisa diklik */
  }
  #siteHeader .nav-pill,
  #siteHeader #mobileMenu {
    pointer-events: auto;
  }

  /* Blur gradient di belakang header — gaussian blur murni dari konten,
     tanpa tinta putih; tebal saat scroll, pudar ke bawah */
  #siteHeader .header-blur {
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 160px;
    pointer-events: none;
    background: transparent;
    -webkit-backdrop-filter: blur(calc(var(--hp) * 18px)) saturate(1.2);
    backdrop-filter: blur(calc(var(--hp) * 18px)) saturate(1.2);
    -webkit-mask-image: linear-gradient(to bottom, black 25%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 25%, transparent 100%);
  }

  /* Di mobile jangkauan blur diperpanjang ke bawah */
  @media (max-width: 768px) {
    #siteHeader .header-blur {
      height: 240px;
    }
  }

  /* Pill melayang ala Dreamina — full transparan saat di atas */
  #siteHeader .nav-pill {
    position: relative;
    z-index: 1;
    width: min(1260px, 94%);
    margin-inline: auto;
    border-radius: 22px;
    padding-inline: clamp(0.9rem, 2.5vw, 1.4rem);
    background: linear-gradient(
      to bottom,
      rgba(250, 247, 242, calc(var(--hp) * 0.82)),
      rgba(250, 247, 242, calc(var(--hp) * 0.66))
    );
    -webkit-backdrop-filter: blur(calc(var(--hp) * 20px)) saturate(1.5);
    backdrop-filter: blur(calc(var(--hp) * 20px)) saturate(1.5);
    box-shadow: 0 24px 55px -22px rgba(35, 23, 14, calc(var(--hp) * 0.28));
  }
  #siteHeader .nav-shell {
    height: calc(68px - (var(--hp) * 10px));
  }

  /* Logo menyembul keluar dari pill */
  #siteHeader .logo-pop {
    box-shadow: 0 12px 28px -8px rgba(35, 23, 14, 0.45), 0 0 0 3px rgba(255, 255, 255, 0.65);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #siteHeader a:hover .logo-pop { transform: scale(1.06) rotate(-3deg); }

  /* Link desktop */
  #siteHeader .nav-link {
    position: relative;
    border-radius: 9999px;
    padding: 0.55rem 1.05rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  #siteHeader .nav-link:hover {
    color: var(--color-cocoa);
    background: rgba(255, 255, 255, 0.65);
  }
  #siteHeader .nav-link.active {
    color: var(--color-cream);
    background: var(--color-pod);
    box-shadow: 0 8px 20px -8px rgba(35, 23, 14, 0.5);
  }

  /* Ikon sosmed kaca — tanpa border */
  #siteHeader .nav-icon {
    display: grid;
    place-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.6);
    color: var(--color-cocoa);
    box-shadow: 0 6px 16px -6px rgba(35, 23, 14, 0.25);
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  #siteHeader .nav-icon:hover {
    transform: translateY(-2px);
    background: #fff;
    color: var(--color-amber-deep);
  }

  /* Burger 3 garis tanpa lingkaran */
  #siteHeader .nav-burger {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: transparent;
  }
  #siteHeader .nav-burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--color-cocoa);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, width 0.3s ease;
  }
  #siteHeader .nav-burger span:nth-child(1) { width: 24px; }
  #siteHeader .nav-burger span:nth-child(2) { width: 17px; }
  #siteHeader .nav-burger span:nth-child(3) { width: 24px; }
  #siteHeader .nav-burger.open span:nth-child(1) { width: 24px; transform: translateY(8px) rotate(45deg); }
  #siteHeader .nav-burger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  #siteHeader .nav-burger.open span:nth-child(3) { width: 24px; transform: translateY(-8px) rotate(-45deg); }

  /* Panel mobile — kartu kaca selebar pill */
  #mobileMenu {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-10px);
    transition: grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobileMenu .menu-clip { min-height: 0; }
  #mobileMenu .menu-card {
    width: min(1260px, 94%);
    margin: 8px auto 0;
    border-radius: 22px;
    padding: 0.75rem;
    background: rgba(250, 247, 242, 0.88);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    backdrop-filter: blur(24px) saturate(1.5);
    box-shadow: 0 24px 60px rgba(35, 23, 14, 0.22);
  }
  #mobileMenu.open {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: none;
  }
  #mobileMenu .m-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 1rem;
    padding: 0.8rem 1.1rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-cocoa);
    opacity: 0;
    translate: 0 12px;
    transition: opacity 0.35s ease, translate 0.45s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease;
    transition-delay: 0s;
  }
  #mobileMenu.open .m-link {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(0.06s + var(--i) * 0.05s);
  }
  #mobileMenu .m-link:hover { background: rgba(255, 255, 255, 0.7); }
  #mobileMenu .m-link.active { background: var(--color-pod); color: var(--color-cream); }
  #mobileMenu .m-link .m-arrow { color: var(--color-amber-deep); }
  #mobileMenu .m-link.active .m-arrow { color: var(--color-amber-light); }
  #mobileMenu .m-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    border-radius: 1rem;
    background: #25d366;
    color: #fff;
    font-weight: 700;
    padding: 0.85rem;
    opacity: 0;
    translate: 0 12px;
    transition: opacity 0.35s ease, translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobileMenu.open .m-cta {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(0.06s + var(--i) * 0.05s);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobileMenu, #mobileMenu .m-link, #mobileMenu .m-cta { transition-duration: 0.01s; }
  }
</style>

<script>
  const header = document.getElementById('siteHeader');
  const menuBtn = document.getElementById('menuBtn');
  const mobileMenu = document.getElementById('mobileMenu');

  // Blur progresif mengikuti scroll (0 = transparan penuh di atas)
  let ticking = false;
  const applyProgress = () => {
    ticking = false;
    const p = Math.min(1, Math.max(0, window.scrollY / 220));
    header?.style.setProperty('--hp', p.toFixed(3));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(applyProgress);
    }
  };
  applyProgress();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  // Toggle menu mobile
  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle('open', open);
    menuBtn?.classList.toggle('open', open);
    menuBtn?.setAttribute('aria-expanded', String(open));
    mobileMenu?.setAttribute('aria-hidden', String(!open));
  };
  menuBtn?.addEventListener('click', () => setMenu(!mobileMenu?.classList.contains('open')));
  mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setMenu(false);
  });

  // Scrollspy: tandai link section yang sedang terlihat
  const groups = new Map<string, Element[]>();
  document.querySelectorAll('[data-spy]').forEach((l) => {
    const h = l.getAttribute('href');
    if (!h) return;
    if (!groups.has(h)) groups.set(h, []);
    groups.get(h)!.push(l);
  });
  const targets = [...groups.keys()]
    .map((h) => {
      try {
        return document.querySelector(h);
      } catch {
        return null;
      }
    })
    .filter((el): el is Element => !!el);
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = '#' + (e.target as HTMLElement).id;
        groups.forEach((ls, h) => ls.forEach((l) => l.classList.toggle('active', h === id)));
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );
  targets.forEach((t) => spy.observe(t));
</script>
