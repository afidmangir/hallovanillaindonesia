---
import FloatingWA from "./react/FloatingWA.tsx";
import WaIcon from "./WaIcon.astro";
const WA = "https://wa.me/62881026050105?text=Hello%20hallovanilla%2C%20I%20would%20like%20to%20ask%20about%20your%20vanilla%20beans.";
const IG = "https://instagram.com/hallovanilla.indonesia";
---

<footer class="border-t border-white/10 bg-night-deep pb-9 pt-16 text-[#C0AEA3]">
  <div class="mx-auto w-[min(1260px,92%)]">
    <div class="mb-12 grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_0.7fr_0.7fr_1fr]">
      <div>
        <div class="mb-3.5 flex items-center gap-2.5">
          <img src="/logo-white.png" alt="hallovanilla logo" class="h-10 w-10 rounded-full border border-amber-glow object-cover" />
          <span class="font-serif-display text-[1.4rem] font-semibold lowercase text-cream">hallovanilla</span>
        </div>
        <p class="mb-5 max-w-[360px] text-[0.9rem] leading-relaxed">Carefully cured Indonesian vanilla beans — Planifolia, Tahitian & Powder. Based in Surabaya, East Java.</p>
        <div class="flex gap-2.5">
          <a href="mailto:hallovanillaindonesia@gmail.com" aria-label="Email" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 transition hover:-translate-y-0.5 hover:border-amber-glow hover:text-amber-light">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </a>
          <a href={IG} target="_blank" rel="noopener" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 transition hover:-translate-y-0.5 hover:border-amber-glow hover:text-amber-light">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href={WA} target="_blank" rel="noopener" aria-label="WhatsApp" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 transition hover:-translate-y-0.5 hover:border-amber-glow hover:text-amber-light">
            <WaIcon size={18} />
          </a>
          <a href="https://maps.google.com/?q=Banyu+Urip+Wetan+5+No+15+Surabaya" target="_blank" rel="noopener" aria-label="Location" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 transition hover:-translate-y-0.5 hover:border-amber-glow hover:text-amber-light">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4 class="mb-5 text-[0.8rem] font-bold uppercase tracking-[0.16em] text-cream">Explore</h4>
        <ul class="flex flex-col gap-3 text-[0.9rem]">
          <li><a href="#home" class="transition hover:translate-x-1 hover:text-amber-light inline-block">Home</a></li>
          <li><a href="#story" class="transition hover:translate-x-1 hover:text-amber-light inline-block">Story</a></li>
          <li><a href="#products" class="transition hover:translate-x-1 hover:text-amber-light inline-block">Products</a></li>
          <li><a href="#gallery" class="transition hover:translate-x-1 hover:text-amber-light inline-block">Gallery</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-5 text-[0.8rem] font-bold uppercase tracking-[0.16em] text-cream">Products</h4>
        <ul class="flex flex-col gap-3 text-[0.9rem]">
          <li><a href="#products" class="transition hover:text-amber-light">Planifolia</a></li>
          <li><a href="#products" class="transition hover:text-amber-light">Tahitian</a></li>
          <li><a href="#products" class="transition hover:text-amber-light">Powder</a></li>
          <li><a href="#contact" class="transition hover:text-amber-light">Wholesale</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-5 text-[0.8rem] font-bold uppercase tracking-[0.16em] text-cream">Contact</h4>
        <ul class="flex flex-col gap-3 text-[0.9rem]">
          <li>
            <a href="mailto:hallovanillaindonesia@gmail.com" class="inline-flex items-center gap-2.5 hover:text-amber-light">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              <span class="break-all">hallovanillaindonesia@gmail.com</span>
            </a>
          </li>
          <li>
            <a href={IG} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 hover:text-amber-light">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <span>@hallovanilla.indonesia</span>
            </a>
          </li>
          <li>
            <a href={WA} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 hover:text-amber-light">
              <WaIcon size={15} />
              <span>+62 881-0260-50105</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 pt-8 text-center text-[0.8rem] text-[#8C7A70] md:text-left">
      <div>© <span id="currentYear">2026</span> hallovanilla. All rights reserved.</div>
    </div>
  </div>
</footer>

<!-- Floating WA: ikon saja -->
<FloatingWA client:load />

<script>
  const y = document.getElementById('currentYear');
  if (y) y.textContent = String(new Date().getFullYear());
</script>
