---
import Reveal from "./react/Reveal.tsx";
const gallery = [
  { img: "/hallovanilla2.jpeg", badge: "Origin Plantation", title: "Lush Vanilla Vines — East Java", v: "left" as const },
  { img: "/hallovanilla3.jpeg", badge: "Artisan Curing", title: "Traditional Sun-Sweating & Sorting", v: "right" as const },
  { img: "/vanillaplanifolia.jpeg", badge: "Culinary Craft", title: "Gourmet Pods & Vanilla Caviar", v: "left" as const },
  { img: "/vanillapowder.jpeg", badge: "Pure Essence", title: "Single-Origin Powder & Conditioning", v: "right" as const },
];
---

<section class="bg-cream py-24 md:py-28" id="gallery">
  <div class="mx-auto w-[min(1260px,92%)]">
    <Reveal client:visible variant="blur">
      <div class="mx-auto max-w-[680px] text-center">
        <span class="mb-3 inline-block text-[0.76rem] font-bold uppercase tracking-[0.22em] text-toffee">Visual Journal</span>
        <h2 class="font-serif-display text-[clamp(2.2rem,3.8vw,3.2rem)] font-medium">The Essence of Real Vanilla</h2>
        <p class="mt-3 text-muted">An intimate glimpse — all photos from our own stock: origin vines, curing, and culinary craft.</p>
      </div>
    </Reveal>
    <div class="mt-12 grid grid-cols-12 gap-6">
      {gallery.map((g, i) => (
        <Reveal client:visible variant={g.v} delay={(i % 2) * 0.1} className={i % 2 === 0 ? "col-span-12 md:col-span-7" : "col-span-12 md:col-span-5"}>
          <div class="group relative h-[340px] overflow-hidden rounded-[26px] border border-line bg-night shadow-sm transition-all duration-500 hover:-translate-y-2 hover:border-amber-glow hover:shadow-[0_20px_45px_rgba(30,19,11,0.15)] md:h-[410px]">
            <img src={g.img} alt={g.title} class="h-full w-full object-cover transition duration-[1.1s] group-hover:rotate-[0.5deg] group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-night-deep/90 via-night-deep/10 to-transparent opacity-90 transition group-hover:opacity-100"></div>
            <div class="absolute inset-0 flex flex-col justify-end p-7 text-cream transition-transform duration-500 group-hover:-translate-y-1">
              <span class="mb-2 w-fit rounded-full border border-white/15 bg-night/75 px-3.5 py-1.5 text-[0.76rem] font-semibold text-amber-light backdrop-blur">{g.badge}</span>
              <h3 class="font-serif-display text-[1.35rem] font-semibold leading-snug">{g.title}</h3>
            </div>
          </div>
        </Reveal>
      ))}
    </div>
    <Reveal client:visible variant="zoom">
      <div class="group relative mt-6 h-[320px] overflow-hidden rounded-[26px] border border-line">
        <img src="/hallovanilla4.jpeg" alt="Bulk cured vanilla beans hallovanilla" class="h-full w-full object-cover transition duration-[1.1s] group-hover:scale-108 group-hover:scale-110" loading="lazy" />
        <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-night-deep/90 via-transparent to-transparent p-7 text-cream">
          <span class="mb-2 w-fit rounded-full border border-white/15 bg-night/75 px-3.5 py-1.5 text-[0.76rem] font-semibold text-amber-light">Bulk & Export Ready</span>
          <h3 class="font-serif-display text-[1.35rem] font-semibold">Sorted, Graded & Vacuum-Sealed for Export</h3>
        </div>
      </div>
    </Reveal>
  </div>
</section>
