---
import Reveal from "./react/Reveal.tsx";
const rows = [
  { f: "Overall character", p: "Rich, dark, warm, and classic", t: "Floral, fruity, delicate, aromatic", w: "Concentrated, bold, ready-to-mix" },
  { f: "Aroma direction", p: "Vanillin-dominant, buttery", t: "Anisic, stone fruit, cherry", w: "Roasted vanilla, seed-flecked" },
  { f: "Ideal applications", p: "Cakes, cookies, extract, chocolate", t: "Crème anglaise, gelato, fruit desserts", w: "Dough, coffee, drinks, instant mix" },
  { f: "Who may prefer it?", p: "Traditional intense vanilla lovers", t: "Chefs seeking nuanced scent", w: "Bakeries needing practical dosing" },
];
---

<section class="bg-cream py-24 md:py-28" id="comparison">
  <div class="mx-auto w-[min(1260px,92%)]">
    <Reveal client:visible variant="blur">
      <div class="mx-auto mb-12 max-w-[680px] text-center">
        <span class="mb-3 inline-block text-[0.76rem] font-bold uppercase tracking-[0.22em] text-toffee">Planifolia vs Tahitian vs Powder</span>
        <h2 class="font-serif-display text-[clamp(2.2rem,3.8vw,3.2rem)] font-medium">Find the right character</h2>
        <p class="mt-3 text-muted">All three have their place in fine pastry and culinary creations.</p>
      </div>
    </Reveal>
    <Reveal client:visible variant="zoom" delay={0.1}>
      <div class="overflow-x-auto rounded-[26px] border border-line bg-white p-2 shadow-sm transition-shadow hover:shadow-[0_20px_45px_rgba(30,19,11,0.12)]">
        <table class="w-full min-w-[760px] border-separate border-spacing-0 text-left">
          <thead>
            <tr>
              <th class="bg-sand px-7 py-5 text-[0.82rem] font-bold uppercase tracking-[0.12em] text-pod rounded-tl-2xl">Characteristic</th>
              <th class="bg-amber-glow/15 px-7 py-5 text-[0.82rem] font-bold uppercase tracking-[0.12em] text-pod">Planifolia</th>
              <th class="bg-sand px-7 py-5 text-[0.82rem] font-bold uppercase tracking-[0.12em] text-pod">Tahitian</th>
              <th class="bg-sand px-7 py-5 text-[0.82rem] font-bold uppercase tracking-[0.12em] text-pod rounded-tr-2xl">Powder</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="transition hover:bg-sand/60">
                <td class="border-b border-line px-7 py-5 font-semibold text-pod">{r.f}</td>
                <td class="border-b border-line px-7 py-5 text-[0.94rem]">{r.p}</td>
                <td class="border-b border-line px-7 py-5 text-[0.94rem]">{r.t}</td>
                <td class="border-b border-line px-7 py-5 text-[0.94rem]">{r.w}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Reveal>
  </div>
</section>
