---
import Reveal from "./react/Reveal.tsx";
import ComparisonInteractive from "./react/ComparisonInteractive.tsx";
---

<section class="relative overflow-hidden bg-cream py-24 md:py-28" id="comparison">
  <div aria-hidden class="pointer-events-none absolute -left-40 top-10 h-[380px] w-[380px] rounded-full bg-amber-glow/10 blur-[110px]"></div>
  <div aria-hidden class="pointer-events-none absolute -right-40 bottom-0 h-[320px] w-[320px] rounded-full bg-amber-glow/[0.07] blur-[100px]"></div>
  <div class="relative mx-auto w-[min(1260px,92%)]">
    <Reveal client:visible variant="blur">
      <div class="mx-auto mb-12 max-w-[680px] text-center">
        <span class="mb-3 inline-flex items-center gap-2 text-[0.76rem] font-bold uppercase tracking-[0.22em] text-toffee"><span class="h-px w-8 bg-amber-glow"></span>Planifolia vs Tahitian vs Powder<span class="h-px w-8 bg-amber-glow"></span></span>
        <h2 class="font-serif-display text-[clamp(2.2rem,3.8vw,3.2rem)] font-medium">Find the right <span class="italic text-toffee">character</span></h2>
        <p class="mt-3 text-muted">All three have their place in fine pastry and culinary creations. <span class="font-semibold text-pod">Tap a column</span> to compare.</p>
      </div>
    </Reveal>
    <ComparisonInteractive client:visible />
    <Reveal client:visible variant="up" delay={0.15}>
      <p class="mt-8 text-center text-[0.88rem] text-muted">Not sure which fits your recipe? <a href="https://wa.me/62881026050105?text=Hello%20hallovanilla%2C%20I%20need%20help%20choosing%20vanilla." target="_blank" rel="noopener" class="font-bold text-toffee underline decoration-amber-glow/60 underline-offset-4 transition hover:text-amber-deep">Ask us on WhatsApp →</a></p>
    </Reveal>
  </div>
</section>
