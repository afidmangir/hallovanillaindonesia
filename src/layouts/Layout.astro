---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "hallovanilla.indonesia — Premium Indonesian Vanilla Beans (Planifolia & Tahitian) | Surabaya Exporter",
  description = "hallovanilla.indonesia supplies Grade A Indonesian vanilla beans — Planifolia, Tahitian & Powder — graded, vacuum-sealed and exported worldwide from Surabaya, East Java. Request a wholesale quotation today.",
} = Astro.props;
import "../styles/global.css";
const site = "https://hallovanillaindonesia.com";
const ogImage = `${site}/halovanillaog.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="haloafid" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="keywords" content="indonesian vanilla beans, vanilla planifolia, tahitian vanilla, vanilla powder, vanilla exporter indonesia, vanilla surabaya, gourmet vanilla, wholesale vanilla beans" />
    <meta name="theme-color" content="#1E130B" />
    <link rel="canonical" href={site} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="hallovanilla.indonesia" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1349" />
    <meta property="og:image:height" content="625" />
    <meta property="og:image:alt" content="hallovanilla.indonesia — Pure aroma, real vanilla" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo (Surabaya, East Java) -->
    <meta name="geo.region" content="ID-JI" />
    <meta name="geo.placename" content="Surabaya" />
    <meta name="ICBM" content="-7.2575, 112.7521" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo-white.png" />
    <link rel="preload" as="image" href="/logo-white.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://hallovanillaindonesia.com/#org",
            "name": "hallovanilla.indonesia",
            "url": "https://hallovanillaindonesia.com/",
            "logo": "https://hallovanillaindonesia.com/logo-white.png",
            "image": "https://hallovanillaindonesia.com/halovanillaog.png",
            "description": "Exporter of Grade A Indonesian vanilla beans — Planifolia, Tahitian & Powder — from Surabaya, East Java.",
            "email": "hallovanillaindonesia@gmail.com",
            "telephone": "+62-881-0260-50105",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Banyu Urip Wetan 5 No. 15",
              "addressLocality": "Surabaya",
              "addressRegion": "East Java",
              "addressCountry": "ID"
            },
            "sameAs": ["https://instagram.com/hallovanilla.indonesia"]
          },
          {
            "@type": "WebSite",
            "@id": "https://hallovanillaindonesia.com/#site",
            "url": "https://hallovanillaindonesia.com/",
            "name": "hallovanilla.indonesia",
            "publisher": { "@id": "https://hallovanillaindonesia.com/#org" },
            "inLanguage": "en"
          }
        ]
      }
    </script>
    <script is:inline>
      document.documentElement.classList.add("veil-on");
    </script>
    <style>
      /* ===== Loading veil (instant first paint, no JS needed to appear) ===== */
      html.veil-on, html.veil-on body { overflow: hidden; }
      #veil {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 38%, #fdf8f0 0%, #FAF7F2 55%, #f3e9db 100%);
        transition: clip-path 0.95s cubic-bezier(0.76, 0, 0.24, 1);
        clip-path: inset(0 0 0 0);
      }
      #veil-shadow {
        position: fixed; inset: 0; z-index: 9998; background: #1E130B;
        transition: clip-path 0.95s cubic-bezier(0.76, 0, 0.24, 1) 0.12s;
        clip-path: inset(0 0 0 0);
      }
      #veil.done { clip-path: inset(0 0 100% 0); }
      #veil-shadow.done { clip-path: inset(0 0 100% 0); }
      #veil-inner {
        display: flex; flex-direction: column; align-items: center;
        transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.45s ease;
      }
      #veil.done #veil-inner { opacity: 0; transform: translateY(-34px) scale(0.96); filter: blur(6px); }
      .veil-blob { position: absolute; border-radius: 9999px; filter: blur(70px); pointer-events: none; }
      .veil-blob-a { width: 340px; height: 340px; background: rgba(198,139,69,0.22); top: 8%; left: 50%; margin-left: -260px; animation: veilDrift 5s ease-in-out infinite alternate; }
      .veil-blob-b { width: 260px; height: 260px; background: rgba(176,116,52,0.16); bottom: 6%; left: 50%; margin-left: 60px; animation: veilDrift 6s ease-in-out infinite alternate-reverse; }
      @keyframes veilDrift { from { transform: translate(0,0) scale(1); } to { transform: translate(30px,24px) scale(1.12); } }
      /* Art tumbuh dari bawah ke atas */
      .veil-art-wrap { position: relative; width: min(240px, 58vw); aspect-ratio: 1; transform-origin: 50% 100%; }
      .veil-art-ring {
        position: absolute; inset: -14px; border-radius: 9999px;
        border: 1px solid rgba(198,139,69,0.35);
        animation: veilRing 2.4s ease-out infinite;
      }
      .veil-art-ring.r2 { animation-delay: 1.2s; }
      @keyframes veilRing { 0% { transform: scale(0.92); opacity: 0; } 30% { opacity: 0.9; } 100% { transform: scale(1.12); opacity: 0; } }
      .veil-art {
        width: 100%; height: 100%; object-fit: cover;
        border-radius: 9999px;
        transform-origin: 50% 100%;
        clip-path: inset(100% 0 0 0);
        transform: scale(0.9) translateY(26px);
        filter: blur(8px);
        animation: veilGrow 2s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
      }
      @keyframes veilGrow {
        0% { clip-path: inset(100% 0 0 0); transform: scale(0.9) translateY(26px); filter: blur(8px); }
        55% { filter: blur(0px); }
        100% { clip-path: inset(0 0 0 0); transform: scale(1) translateY(0); filter: blur(0px); }
      }
      /* Garis tanah + cahaya tumbuh */
      .veil-soil { width: 150px; height: 2px; margin-top: 10px; border-radius: 2px; background: linear-gradient(90deg, transparent, #C68B45, transparent); transform: scaleX(0); animation: veilSoil 1.6s ease 0.3s forwards; }
      @keyframes veilSoil { to { transform: scaleX(1); } }
      .veil-sub {
        margin-top: 22px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: #A96E2E;
        opacity: 0; animation: veilRise 0.9s ease 1.1s forwards;
      }
      @keyframes veilRise { to { opacity: 1; transform: translateY(0); } }
      .veil-bar { width: 180px; height: 2px; margin-top: 26px; border-radius: 2px; background: #E8DDD2; overflow: hidden; opacity: 0; animation: veilRise 0.6s ease 1.3s forwards; }
      .veil-bar i { display: block; height: 100%; width: 0%; border-radius: 2px; background: linear-gradient(90deg, #C68B45, #A96E2E); }
      .veil-pct { margin-top: 10px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; color: #5C483D; opacity: 0; animation: veilRise 0.6s ease 1.3s forwards; }
      @media (prefers-reduced-motion: reduce) {
        .veil-art { animation-duration: 0.3s; }
        #veil, #veil-shadow { transition-duration: 0.3s; }
      }
    </style>
  </head>
  <body class="bg-cream text-cocoa antialiased">
    <!-- Loading veil: vanilla line-art tumbuh, lalu tirai terangkat -->
    <div id="veil-shadow" aria-hidden="true"></div>
    <div id="veil" role="status" aria-label="Memuat hallovanilla">
      <div class="veil-blob veil-blob-a"></div>
      <div class="veil-blob veil-blob-b"></div>
      <div id="veil-inner">
        <div class="veil-art-wrap">
          <div class="veil-art-ring"></div>
          <div class="veil-art-ring r2"></div>
          <img class="veil-art" src="/logo-white.png" alt="hallovanilla logo" width="240" height="240" fetchpriority="high" />
        </div>
        <div class="veil-soil"></div>
        <div class="veil-sub">Surabaya • Indonesia</div>
        <div class="veil-bar"><i id="veil-fill"></i></div>
        <div class="veil-pct"><span id="veil-num">0</span>%</div>
      </div>
    </div>

    <slot />

    <script is:inline>
      (function () {
        var veil = document.getElementById("veil");
        var shadow = document.getElementById("veil-shadow");
        var fill = document.getElementById("veil-fill");
        var num = document.getElementById("veil-num");
        if (!veil) return;
        var t0 = performance.now();
        var MIN_MS = 2500; // beri waktu animasi tumbuh selesai
        var progress = 0;
        var pageLoaded = document.readyState === "complete";
        var finished = false;

        // Preload aset kunci agar halaman benar-benar siap saat tirai dibuka
        ["\/logo-white.png", "\/logo-brown.png", "\/hallovanilla4.jpeg", "\/hallovanilla1.jpeg"].forEach(function (src) {
          var im = new Image();
          im.src = src;
        });

        window.addEventListener("load", function () { pageLoaded = true; });
        setTimeout(function () { pageLoaded = true; }, 6000); // pengaman

        function paint(p) {
          if (fill) fill.style.width = p + "%";
          if (num) num.textContent = Math.floor(p);
        }

        function finish() {
          if (finished) return;
          finished = true;
          paint(100);
          setTimeout(function () {
            veil.classList.add("done");
            if (shadow) shadow.classList.add("done");
            setTimeout(function () {
              if (veil.parentNode) veil.parentNode.removeChild(veil);
              if (shadow && shadow.parentNode) shadow.parentNode.removeChild(shadow);
              document.documentElement.classList.remove("veil-on");
              document.documentElement.classList.add("is-ready");
              window.dispatchEvent(new CustomEvent("halloready"));
            }, 1150);
          }, 250);
        }

        (function tick() {
          if (finished) return;
          var elapsed = performance.now() - t0;
          // progress cepat ke 88%, sisanya menunggu halaman + waktu minimum
          var target = pageLoaded ? 100 : 88;
          progress += (target - progress) * 0.06 + 0.25;
          if (progress > 99.4 && !(pageLoaded && elapsed >= MIN_MS)) progress = 99.4;
          if (progress >= 99.4) progress = 99.4;
          paint(Math.min(progress, 99));
          if (pageLoaded && elapsed >= MIN_MS) {
            // easing terakhir menuju 100
            var last = setInterval(function () {
              progress += (100 - progress) * 0.25 + 0.4;
              if (progress >= 99.9) { clearInterval(last); finish(); }
              else paint(progress);
            }, 50);
          } else {
            requestAnimationFrame(tick);
          }
        })();

        setTimeout(finish, 9000); // pengaman absolut
      })();
    </script>
  </body>
</html>
